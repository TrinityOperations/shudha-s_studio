# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or the legacy service_role JWT, from the SAME project. Used only on the
# server for Storage uploads. A key from another project fails with "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Project Settings → Database → Connection string)
# DATABASE_URL: "Transaction" pooler (port 6543), used by the app at runtime.
# DIRECT_DATABASE_URL: "Session" pooler (port 5432), used only by drizzle-kit migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional: max connections per process (default 10). Lower it on Netlify, e.g. 3.
# DB_POOL_MAX=

# Resend (resend.com → API Keys). Keys start with "re_"; anything else switches sendEmail to dry run.
RESEND_API_KEY=
# Optional sender; defaults to Resend's sandbox sender until the studio domain is verified in Resend.
EMAIL_FROM=
# Optional: set to 1 to log emails instead of sending them (handy in local dev).
EMAIL_DRY_RUN=
# Optional: bearer token for /api/cron/reminders (min 16 chars). Unset disables the reminder job.
CRON_SECRET=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile)
# Locally and for e2e, use Cloudflare's always-pass test keys below: a headless browser cannot
# solve the real challenge, so the sign-in e2e test fails with real keys. Put the real site key
# and secret from the Cloudflare dashboard in Netlify's environment variables for production only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The only email allowed into /admin (compared case-insensitively).
OWNER_EMAIL=owner@dev.com

# Playwright (optional): credentials of the owner account for the login e2e test
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
