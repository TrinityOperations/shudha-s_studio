# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Project Settings → Database → Connection string)
# DATABASE_URL: "Transaction" pooler (port 6543), used by the app at runtime.
# DIRECT_DATABASE_URL: "Session" pooler (port 5432), used only by drizzle-kit migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Resend (resend.com → API Keys)
RESEND_API_KEY=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile)
# Local dev / e2e can use Cloudflare's always-pass test keys:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The only email allowed into /admin (compared case-insensitively).
OWNER_EMAIL=owner@dev.com

# Playwright (optional): credentials of the owner account for the login e2e test
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
